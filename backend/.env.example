PROJECT_NAME="Transit Accessibility Gap Compass"
API_V1_STR="/api"
ENVIRONMENT="development"
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Provider Modes: mock | excel | geomapid | local_geojson
DATA_SOURCE_MODE="local_geojson"
GEO_API_MODE="mock"
VISION_MODE="mock"

# Credentials for production mode
EXCEL_FILE_PATH="data/kelurahan_data.xlsx"
GEOMAPID_API_KEY=""
GEOMAPID_API_URL="https://geoserver.mapid.io/layers_new/get_layer"
GEOMAPID_LAYER_ID=""
GEOMAPID_PROJECT_ID=""
GEOMAPID_DEMOGRAPHY_LAYER_ID="6a7c7f9bb879bb821d798582"
GEOMAPID_RECOMMENDATION_AREA_LAYER_ID="6a7c7f9bb879bb821d798586"
GEOMAPID_GAP_AREA_LAYER_ID="6a7c7f9bb879bb821d798588"
GEOMAPID_RECOMMENDATION_POINT_LAYER_ID="6a7c7f9bb879bb821d79858a"
VLM_API_KEY=""
VLM_PROVIDER="gemini" # gemini | openai (openai = OpenAI-compatible, bisa custom base URL)
VLM_BASE_URL="https://api.openai.com/v1" # contoh: https://openrouter.ai/api/v1, http://localhost:11434/v1
VLM_MODEL="gpt-4o-mini" # contoh: qwen/qwen2.5-vl, llama3.2-vision, gemini-2.0-flash
